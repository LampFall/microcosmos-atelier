---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta
      name="description"
      content="Explore real Microcosmos Atelier projects — living aquatic ecosystems designed and built for individual spaces."
    />

    <title>Microcosmos — Microcosmos Atelier</title>
  </head>

  <body>
    <header class="page-header">
      <nav class="nav">
        <a href="/" class="logo">
          Microcosmos Atelier
        </a>

        <div class="navigation">
          <a href="/microcosmos">Microcosmos</a>
          <a href="/our-work">Our Work</a>
          <a href="/formulas">Formulas</a>
          <a href="/about">About</a>
          <a href="/#contact">Contact</a>
        </div>
      </nav>
    </header>

    <main>
      <!-- INTRO -->
      <section class="page-intro">
        <p class="eyebrow">
          Microcosmos
        </p>

        <h1>
          Living worlds,<br />
          made for real spaces.
        </h1>

        <p class="page-intro-text">
          Every Microcosmos is different. Each one starts with a space,
          a conversation and an idea of the kind of nature that could
          live there.
        </p>

        <p class="page-intro-text">
          Here are some of the worlds I've created so far.
        </p>
      </section>

      <!-- PROJECT 01 -->
      <section class="project">
        <div class="project-image">
          <img
            src="/images/our-work/A002-01.jpeg"
            alt="Microcosmos Atelier aquarium installation"
          />
        </div>

        <div class="project-content">
          <p class="eyebrow">
            Microcosmos 01
          </p>

          <h2>
            Designed around<br />
            the space.
          </h2>

          <p>
            A living aquatic ecosystem designed as an integral part
            of its surroundings rather than simply placed inside them.
          </p>
        </div>
      </section>

      <!-- PROJECT 02 -->
      <section class="project project-reverse">
        <div class="project-image">
          <img
            src="/images/our-work/A003-01.jpeg"
            alt="Microcosmos Atelier aquarium"
          />
        </div>

        <div class="project-content">
          <p class="eyebrow">
            Microcosmos 02
          </p>

          <h2>
            A little piece<br />
            of nature.
          </h2>

          <p>
            Built to become part of everyday life — something that
            changes, grows and develops rather than remaining static.
          </p>
        </div>
      </section>

      <!-- PROJECT 03 -->
      <section class="project">
        <div class="project-image">
          <img
            src="/images/our-work/A004-01.jpeg"
            alt="Complete Microcosmos Atelier installation"
          />
        </div>

        <div class="project-content">
          <p class="eyebrow">
            Microcosmos 03
          </p>

          <h2>
            An ecosystem,<br />
            not a decoration.
          </h2>

          <p>
            Plants, water, substrate, microorganisms and animals
            interacting as one continuously evolving system.
          </p>
        </div>
      </section>

      <!-- PROJECT 04 -->
      <section class="project project-reverse">
        <div class="project-image">
          <img
            src="/images/our-work/A002-full dark.jpeg"
            alt="Microcosmos Atelier aquatic ecosystem"
          />
        </div>

        <div class="project-content">
          <p class="eyebrow">
            Microcosmos 04
          </p>

          <h2>
            Every ecosystem<br />
            tells a story.
          </h2>

          <p>
            The materials, plants, light and water all come together
            to create an atmosphere that feels connected to nature.
          </p>
        </div>
      </section>

      <!-- CTA -->
      <section class="cta page-cta">
        <p class="eyebrow">
          Your Microcosmos
        </p>

        <h2>
          What could live<br />
          in your space?
        </h2>

        <p>
          Every project starts with a conversation.
        </p>

        <a
          href="/#contact"
          class="button dark-button"
        >
          Start a conversation
        </a>
      </section>
    </main>

    <footer>
      <p>
        © {new Date().getFullYear()} Microcosmos Atelier
      </p>
    </footer>
  </body>
</html>