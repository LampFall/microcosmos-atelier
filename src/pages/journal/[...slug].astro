---
import { getCollection } from "astro:content";
import JournalEntry from "../../components/pages/JournalEntry.astro";

export async function getStaticPaths() {
	const entries = (await getCollection("journal")).filter(
		(e) => e.data.lang === "nl",
	);
	return entries.map((entry) => ({
		params: { slug: entry.id.replace(/^nl\//, "") },
		props: { entry },
	}));
}

const { entry } = Astro.props;
---

<JournalEntry entry={entry} />
