---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t("contact.meta.title")} description={t("contact.meta.description")}>
  <Header />

  <main id="main">
    <section class="contact-page">
      <div class="contact-page-header">
        <p class="eyebrow">{t("contact.hero.eyebrow")}</p>

        <h1 set:html={t("contact.hero.title")} />

        <p class="contact-page-lead">{t("contact.hero.lead")}</p>
      </div>

      <div class="contact-page-content">
        <div class="contact-page-info">
          <p class="eyebrow">{t("contact.info.eyebrow")}</p>

          <h2>{t("contact.info.title")}</h2>

          <p>{t("contact.info.text")}</p>

          <a href={getRelativeLocaleUrl(lang, "/faq")} class="text-link">
            {t("faq.link")} <span aria-hidden="true">→</span>
          </a>
        </div>

        {/*
          Handled by Netlify Forms (SPEC.md §3.10): Netlify finds this form in
          the built HTML at deploy time. The address that receives the
          notifications is set in the Netlify dashboard, not here. One form
          ("contact") for both languages; the hidden `language` field says
          which one was used. After sending, the visitor lands on the thank-you
          page in their language.
        */}
        <form
          class="contact-form"
          name="contact"
          method="POST"
          action={getRelativeLocaleUrl(lang, "/contact/thanks")}
          data-netlify="true"
          netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value="contact" />
          <input type="hidden" name="language" value={lang} />
          <input type="hidden" name="subject" value={t("contact.form.subject")} />

          {/* Spam trap: hidden from people (sight, screen readers, Tab); bots fill it in. */}
          <p hidden>
            <label>
              {t("contact.form.honeypot")}
              <input name="bot-field" autocomplete="off" />
            </label>
          </p>

          <div class="contact-form-group">
            <label for="name">{t("contact.form.name.label")} <span class="required-mark" aria-hidden="true">*</span></label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>

          <div class="contact-form-group">
            <label for="email">{t("contact.form.email.label")} <span class="required-mark" aria-hidden="true">*</span></label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>

          <div class="contact-form-group">
            <label for="project">{t("contact.form.project.label")}</label>

            <select id="project" name="project">
              <option value="">{t("contact.form.project.placeholder")}</option>
              <option value="new-microcosmos">{t("contact.form.project.new")}</option>
              <option value="existing-aquarium">{t("contact.form.project.existing")}</option>
              <option value="maintenance">{t("contact.form.project.maintenance")}</option>
              <option value="tailored">{t("contact.form.project.tailored")}</option>
              <option value="just-exploring">{t("contact.form.project.exploring")}</option>
            </select>
          </div>

          <div class="contact-form-group">
            <label for="message">{t("contact.form.message.label")} <span class="required-mark" aria-hidden="true">*</span></label>
            <textarea
              id="message"
              name="message"
              placeholder={t("contact.form.message.placeholder")}
              required
            ></textarea>
          </div>

          {/* The * is visual only; screen readers get `required` from the fields. */}
          <p class="contact-form-privacy" aria-hidden="true">* {t("contact.form.required")}</p>

          <p class="contact-form-privacy" id="contact-privacy">
            {t("contact.form.privacy")}{" "}
            <a href={getRelativeLocaleUrl(lang, "/privacy")} class="inline-link">{t("contact.form.privacyLink")}</a>
          </p>

          <button type="submit" class="button dark-button" aria-describedby="contact-privacy">
            {t("contact.form.submit")}
          </button>
        </form>
      </div>
    </section>
  </main>

  <Footer />
</Layout>