---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
// Fixed photo from src/content/site/ (SPEC.md §3.11); replacing it: PHOTOS.md.
import aboutPagePhoto from "../../content/site/about-page.jpg";
import { SITE_PHOTO_QUALITY } from "../../lib/site-photos";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// The 0.75fr column of .about-page-hero (1fr 0.75fr, 100px gap; max 550px wide
// at ≤ 800px). The 3:4 photo fills its 4:5 box by width, so no crop factor.
// Widths stop at 1000: enough for a 2× desktop (≈ 940px), and a 3× phone
// gets 1000 instead of a 1200 file nearly as heavy as the original JPEG.
// `width` keeps the fallback `src` at 1000px as well.
const aboutPageSizes = "(max-width: 800px) min(100vw - 44px, 550px), 471px";
---

<Layout
  title={t("about.meta.title")}
  description={t("about.meta.description")}
  shareImage={{ src: aboutPagePhoto, alt: t("about.image.alt"), position: "bottom" }}
>
  <Header />

  <main id="main">
    <section class="about-page">
      <div class="about-page-hero">
        <div class="about-page-intro">
          <p class="eyebrow">{t("about.hero.eyebrow")}</p>

          <h1 set:html={t("about.hero.title")} />

          <p class="about-page-lead">{t("about.hero.lead")}</p>
        </div>

        <div class="about-page-image">
          <Image
            src={aboutPagePhoto}
            alt={t("about.image.alt")}
            format="webp"
            quality={SITE_PHOTO_QUALITY}
            width={1000}
            widths={[400, 600, 800, 1000]}
            sizes={aboutPageSizes}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="about-page-story">
        <p class="eyebrow">{t("about.story.eyebrow")}</p>

        <h2 set:html={t("about.story.title")} />

        <p>{t("about.story.p1")}</p>
        <p>{t("about.story.p2")}</p>
        <p>{t("about.story.p3")}</p>
        <p>{t("about.story.p4")}</p>
        <p>{t("about.story.p5")}</p>
        <p>
          {t("about.story.linkedinText")}{" "}
          <a
            href="https://www.linkedin.com/in/kasper-masschaele-56752916/"
            class="inline-link"
            rel="me noopener"
            target="_blank"
          >
            {t("about.story.linkedinLabel")}
          </a>.
        </p>

        <div class="about-page-highlight">
          <p>{t("about.story.highlight2")}</p>
        </div>
      </div>
    </section>

    <section class="cta">
      <p class="eyebrow">{t("about.cta.eyebrow")}</p>
      <h2>{t("about.cta.title")}</h2>
      <p>{t("about.cta.text")}</p>

      <a href={getRelativeLocaleUrl(lang, "/contact")} class="button dark-button">
        {t("about.cta.button")}
      </a>
    </section>
  </main>

  <Footer />
</Layout>