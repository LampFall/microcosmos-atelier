---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { Image } from "astro:assets";
import { getEntryPhotos, getJournalEntries } from "../../lib/journal";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";
import "../../styles/journal.css";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// The preview is the photo shown large on the entry page (the first gallery
// photo), or the cover if an entry has only a cover (SPEC.md §3.6).
const entries = (await getJournalEntries(lang)).map((entry) => {
	const { cover, gallery } = getEntryPhotos(entry.aquarium, entry.entrySlug);
	return {
		...entry,
		url: getRelativeLocaleUrl(lang, `/journal/${entry.aquarium}/${entry.entrySlug}`),
		preview: gallery[0] ?? cover,
	};
});

const aquariumNames = [...new Set(entries.map((e) => e.aquariumName))];

const dateFmt = new Intl.DateTimeFormat(lang === "en" ? "en-GB" : "nl-BE", {
	day: "numeric",
	month: "long",
	year: "numeric",
});
---

<Layout title={t("journal.meta.title")} description={t("journal.meta.description")}>
	<Header />

	<main id="main">
		<section class="page-intro">
			<p class="eyebrow">{t("journal.hero.eyebrow")}</p>
			<h1 set:html={t("journal.hero.title")} />
			<p class="page-intro-text">{t("journal.hero.text")}</p>
		</section>

		<section class="section journal">
			{
				aquariumNames.length > 1 && (
					<div class="journal-filters" role="group">
						<button type="button" class="journal-filter is-active" data-tank="">
							{t("journal.filter.all")}
						</button>
						{aquariumNames.map((name) => (
							<button type="button" class="journal-filter" data-tank={name}>
								{name}
							</button>
						))}
					</div>
				)
			}

			{
				entries.length === 0 ? (
					<p class="journal-empty">{t("journal.empty")}</p>
				) : (
					<ol class="journal-ledger">
						{entries.map((entry) => (
							<li
								class:list={["journal-entry", { "has-preview": entry.preview }]}
								data-tank={entry.aquariumName}
							>
								{entry.preview && (
									<a class="journal-preview" href={entry.url} tabindex="-1" aria-hidden="true">
										<Image
											src={entry.preview.image}
											alt=""
											format="webp"
											width={480}
											height={360}
											widths={[240, 480, 800, 1200]}
											sizes="(max-width: 800px) 100vw, 240px"
										/>
									</a>
								)}
								<div class="journal-body">
									<p class="journal-aquarium">
										{entry.aquariumName}
										{entry.aquariumLiters && (
											<span class="journal-liters">{entry.aquariumLiters} L</span>
										)}
									</p>
									<p class="journal-meta">
										<span class="journal-date">{dateFmt.format(entry.data.date)}</span>
										<span class="journal-status">
											{t(`journal.status.${entry.data.status}` as any)}
										</span>
									</p>
									<h2 class="journal-title">
										<a href={entry.url}>{entry.data.title}</a>
									</h2>
									{entry.data.summary && (
										<p class="journal-summary">{entry.data.summary}</p>
									)}
								</div>
							</li>
						))}
					</ol>
				)
			}
		</section>
	</main>

	<Footer />
</Layout>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>(".journal-filter");
	const items = document.querySelectorAll<HTMLLIElement>(".journal-entry");

	buttons.forEach((button) => {
		button.addEventListener("click", () => {
			buttons.forEach((b) => b.classList.remove("is-active"));
			button.classList.add("is-active");
			const tank = button.dataset.tank;
			items.forEach((item) => {
				item.style.display = !tank || item.dataset.tank === tank ? "" : "none";
			});
		});
	});
</script>
