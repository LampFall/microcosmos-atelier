---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import { WORK_FOLDERS, getWorkPhotos } from "../../lib/work";
// Fixed home photos from src/content/site/ (SPEC.md §3.11). Static imports, so
// a missing file fails the build with its path. Replacing one: see PHOTOS.md.
import heroPhoto from "../../content/site/hero.jpg";
import inspirationJungle from "../../content/site/inspiration-jungle.jpg";
import inspirationAmazon from "../../content/site/inspiration-amazon.jpg";
import inspirationBlackwater from "../../content/site/inspiration-blackwater.jpg";
import inspirationCustom from "../../content/site/inspiration-custom.jpg";
import workExtraPhoto from "../../content/site/work-extra.jpg";
import aboutHomePhoto from "../../content/site/about-home.jpg";
import { SITE_PHOTO_QUALITY } from "../../lib/site-photos";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// The three project photos in "Our work" follow each Our Work folder's hero
// (SPEC.md §3.7); the alt texts stay the generic project names.
const workHeroes = [
  { hero: getWorkPhotos(WORK_FOLDERS.project1).hero, alt: t("home.work.image1.alt") },
  { hero: getWorkPhotos(WORK_FOLDERS.project2).hero, alt: t("home.work.image2.alt") },
  { hero: getWorkPhotos(WORK_FOLDERS.project3).hero, alt: t("home.work.image3.alt") },
];
// .work-grid: 2 columns with a 24px gap inside 1280px minus 2 × 40px padding
// (~588px each); 1 column below 800px, with 22px padding.
const workGridSizes =
  "(max-width: 800px) calc(100vw - 44px), (max-width: 1280px) calc((100vw - 104px) / 2), 588px";
// The four inspiration cards, in order; their texts are home.inspiration<n>.*.
// `englishTitle`: the title is English on the Dutch page too (e.g. "Forest"),
// so it gets lang="en" there for screen readers.
const inspirationCards = [
  { n: 1, photo: inspirationJungle, englishTitle: true },
  { n: 2, photo: inspirationAmazon, englishTitle: true },
  { n: 3, photo: inspirationBlackwater, englishTitle: true },
  { n: 4, photo: inspirationCustom, englishTitle: false },
] as const;
// `sizes` below is the width each photo is drawn at after `object-fit: cover`
// cropping, not just its box:
// - Hero: a 3:4 portrait covering the full width and the height (100vh,
//   90vh at ≤ 800px), so on a portrait phone it's drawn wider than the
//   screen (0.75 × the height). It stops at 1440px (`width` too, so the
//   fallback `src` isn't the full 1500px file): the largest file stays under
//   the 400 KB phone budget.
const heroSizes = "(max-width: 800px) max(100vw, 67.5vh), max(100vw, 75vh)";
// - Inspiration cards: the same columns as .work-grid, but the 1408×768
//   (1.83:1) photos are cropped to a 4:3 box, so drawn 1.375 × wider.
const inspirationSizes =
  "(max-width: 800px) calc((100vw - 44px) * 1.375), (max-width: 1280px) calc((100vw - 104px) / 2 * 1.375), 808px";
// - About photo: the 0.8fr column of .about (1fr 0.8fr, 100px gap; max 500px
//   wide at ≤ 800px); the square photo is cropped to 4:5, so drawn 1.25 × wider.
const aboutSizes = "(max-width: 800px) calc(min(100vw - 44px, 500px) * 1.25), 611px";
---

<Layout
  title={t("home.meta.title")}
  description={t("home.meta.description")}
  shareImage={{ src: heroPhoto, alt: t("home.hero.imageAlt") }}
>
  <Header variant="site" />

  <main id="main">
    <!-- HERO -->
    <section class="hero">
      <Image
        src={heroPhoto}
        alt={t("home.hero.imageAlt")}
        class="hero-image"
        format="webp"
        quality={SITE_PHOTO_QUALITY}
        width={1440}
        widths={[640, 960, 1280, 1440]}
        sizes={heroSizes}
        loading="eager"
        fetchpriority="high"
      />

      <div class="hero-overlay">
        <p class="eyebrow">{t("home.hero.eyebrow")}</p>
        <h1 set:html={t("home.hero.title")} />
        <p class="hero-text">{t("home.hero.text")}</p>
      </div>
    </section>

    <!-- WHAT IS A MICROCOSMOS -->
    <section id={t("home.intro.anchor")} class="intro">
      <p class="eyebrow">{t("home.intro.eyebrow")}</p>
      <h2 set:html={t("home.intro.title")} />

      <div class="intro-columns">
        <div>
          <p>{t("home.intro.col1")}</p>
        </div>

        <div>
          <p>{t("home.intro.col2.p1")}</p>
          <p>{t("home.intro.col2.p2")}</p>
        </div>
      </div>
    </section>

    <!-- THE IDEA -->
    <section class="section philosophy">
      <div class="section-heading">
        <p class="eyebrow">{t("home.philosophy.eyebrow")}</p>
        <h2 set:html={t("home.philosophy.title")} />
      </div>

      <div class="philosophy-content">
        <div class="philosophy-story">
          <p class="lead">{t("home.philosophy.lead")}</p>
          <p>{t("home.philosophy.p1")}</p>
          <p>{t("home.philosophy.p2")}</p>
          <p>{t("home.philosophy.p3")}</p>
          <p>{t("home.philosophy.p4")}</p>
          <p>{t("home.philosophy.p5")}</p>
          <p>{t("home.philosophy.p6")}</p>
          <p class="philosophy-highlight">{t("home.philosophy.highlight")}</p>
        </div>

        <div class="ecosystem-layers">
          {([1, 2, 3, 4, 5, 6] as const).map((n) => (
            <div>
              <span>0{n}</span>
              <strong>{t(`home.layer${n}.title`)}</strong>
              <p>{t(`home.layer${n}.text`)}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- INSPIRATION -->
    <section class="section inspiration">
      <div class="section-heading">
        <p class="eyebrow">{t("home.inspiration.eyebrow")}</p>
        <h2 set:html={t("home.inspiration.title")} />
        <p class="section-intro">{t("home.inspiration.text")}</p>
      </div>

      <div class="microcosmos-grid">
        {inspirationCards.map(({ n, photo, englishTitle }) => (
          <article class="microcosmos-card">
            <Image
              src={photo}
              alt={t(`home.inspiration${n}.imageAlt`)}
              format="webp"
              quality={SITE_PHOTO_QUALITY}
              widths={[400, 600, 820, 1100, 1408]}
              sizes={inspirationSizes}
            />
            <div class="card-content">
              <p class="eyebrow">{t(`home.inspiration${n}.eyebrow`)}</p>
              <h3 lang={englishTitle && lang === "nl" ? "en" : undefined}>{t(`home.inspiration${n}.title`)}</h3>
              <p>{t(`home.inspiration${n}.text`)}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="section process">
      <div class="section-heading">
        <p class="eyebrow">{t("home.process.eyebrow")}</p>
        <h2 set:html={t("home.process.title")} />
      </div>

      <div class="process-list">
        {([1, 2, 3, 4] as const).map((n) => (
          <article>
            <span> 0{n} </span>
            <div>
              <h3>{t(`home.process${n}.title`)}</h3>
              <p>{t(`home.process${n}.text`)}</p>
            </div>
          </article>
        ))}
      </div>

      <a href={getRelativeLocaleUrl(lang, "/faq")} class="text-link">
        {t("faq.link")} <span aria-hidden="true">→</span>
      </a>
    </section>

    <!-- HOW WE CAN WORK TOGETHER -->
    <section class="section formulas">
      <div class="section-heading">
        <p class="eyebrow">{t("home.formulas.eyebrow")}</p>
        <h2 set:html={t("home.formulas.title")} />
        <p class="section-intro">{t("home.formulas.text")}</p>
      </div>

      <div class="formula-list">
        {([1, 2, 3, 4] as const).map((n) => (
          <article>
            <span> 0{n} </span>
            <div>
              {/* The formula names are English in both languages ("Design", …). */}
              <h3 lang={lang === "nl" ? "en" : undefined}>{t(`home.formula${n}.title`)}</h3>
              <p>{t(`home.formula${n}.text`)}</p>
            </div>
          </article>
        ))}
      </div>

      <a href={getRelativeLocaleUrl(lang, "/contact")} class="text-link">
        {t("home.formulas.cta")} <span aria-hidden="true">→</span>
      </a>
    </section>

    <!-- OUR WORK -->
    <section class="section work-preview">
      <div class="section-heading">
        <p class="eyebrow">{t("home.work.eyebrow")}</p>
        <h2 set:html={t("home.work.title")} />
        <p class="section-intro">{t("home.work.text")}</p>
      </div>

      <div class="work-grid">
        {workHeroes.map(({ hero, alt }) =>
          hero && (
            <Image
              src={hero.image}
              alt={alt}
              format="webp"
              widths={[400, 600, 900, 1200]}
              sizes={workGridSizes}
            />
          )
        )}
        <Image
          src={workExtraPhoto}
          alt={t("home.work.image4.alt")}
          format="webp"
          quality={SITE_PHOTO_QUALITY}
          widths={[400, 600, 900, 1200]}
          sizes={workGridSizes}
        />
      </div>

      <a href={getRelativeLocaleUrl(lang, "/our-work")} class="text-link">
        {t("home.work.cta")} <span aria-hidden="true">→</span>
      </a>
    </section>

    <!-- ABOUT -->
    <section class="about">
      <div class="about-content">
        <p class="eyebrow">{t("home.about.eyebrow")}</p>
        <h2 set:html={t("home.about.title")} />
        <p>{t("home.about.p1")}</p>
        <p>{t("home.about.p2")}</p>
        <p class="about-highlight">{t("home.about.highlight")}</p>
        <a href={getRelativeLocaleUrl(lang, "/about")} class="text-link">{t("home.about.link")} <span aria-hidden="true">→</span></a>
      </div>

      <div class="about-image">
        <Image
          src={aboutHomePhoto}
          alt={t("about.image.alt")}
          format="webp"
          quality={SITE_PHOTO_QUALITY}
          widths={[320, 480, 640]}
          sizes={aboutSizes}
        />
      </div>
    </section>

    <!-- FINAL CTA -->
    <section id="contact" class="cta">
      <p class="eyebrow">{t("home.cta.eyebrow")}</p>
      <h2>{t("home.cta.title")}</h2>
      <p>{t("home.cta.text")}</p>

      <a href={getRelativeLocaleUrl(lang, "/contact")} class="button dark-button">
        {t("home.cta.button")}
      </a>
    </section>
  </main>

  <Footer />
</Layout>
