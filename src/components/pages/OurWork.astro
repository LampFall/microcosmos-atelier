---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import {
  WORK_FOLDERS,
  getWorkAltTexts,
  getWorkPhotos,
  type WorkAltTexts,
  type WorkPhotos,
} from "../../lib/work";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Photos come from src/content/work/<aquarium>/ (SPEC.md §3.7): the first
// photo in natural order is the hero, the rest is the gallery.
// `satisfies` makes `astro check` fail if WORK_FOLDERS gets a project that
// this page doesn't render yet.
type Project = keyof typeof WORK_FOLDERS;
const work = {
  project1: getWorkPhotos(WORK_FOLDERS.project1),
  project2: getWorkPhotos(WORK_FOLDERS.project2),
  project3: getWorkPhotos(WORK_FOLDERS.project3),
} satisfies Record<Project, WorkPhotos>;
const projects = Object.keys(work) as Project[];

// Alt text per photo from each folder's alt.yml, in the page's language;
// without one, the per-project texts in ui.ts.
const altTexts = {
  project1: await getWorkAltTexts(WORK_FOLDERS.project1),
  project2: await getWorkAltTexts(WORK_FOLDERS.project2),
  project3: await getWorkAltTexts(WORK_FOLDERS.project3),
} satisfies Record<Project, WorkAltTexts>;
const altFor = (project: Project, fileName: string, fallback: string) =>
  altTexts[project][fileName]?.[lang] || fallback;
for (const project of projects) {
  if (!work[project].hero) {
    console.warn(`[our-work] src/content/work/${WORK_FOLDERS[project]}/ has no photos; the ${project} case study shows none.`);
  }
}

// Only the first hero on the page loads eagerly; everything else is lazy.
const firstHero = projects.find((p) => work[p].hero);
const heroLoading = (project: Project) =>
  project === firstHero ? ({ loading: "eager", fetchpriority: "high" } as const) : {};

// Content width is 1200px (.case-study: 1280px minus 2 × 40px padding; 22px
// padding at 800px and below). The gallery is a 1.2fr / 0.8fr grid with a
// 20px gap, so its columns are 60% / 40% of (content width − 20px):
// ~708px / ~472px on wide screens.
const heroSizes = "(max-width: 800px) calc(100vw - 44px), (max-width: 1280px) calc(100vw - 80px), 1200px";
const heroWidths = [640, 960, 1200, 1600, 2400];
const galleryProps = (index: number) =>
  index % 2 === 0
    ? {
        widths: [360, 480, 720, 1080, 1420],
        sizes: "(max-width: 800px) calc(100vw - 44px), (max-width: 1280px) calc((100vw - 100px) * 0.6), 708px",
      }
    : {
        widths: [240, 360, 480, 720, 950],
        sizes: "(max-width: 800px) calc(100vw - 44px), (max-width: 1280px) calc((100vw - 100px) * 0.4), 472px",
      };

// Volgorde van de specificatierijen verschilt lichtjes per project
// (zoals in de originele pagina's), dus die geven we hier expliciet op.
const project1Specs = [
  [t("work.spec.started"), t("work.project1.spec.started")],
  [t("work.spec.dimensions"), t("work.project1.spec.dimensions")],
  [t("work.spec.volume"), t("work.project1.spec.volume")],
  [t("work.spec.filtration"), t("work.project1.spec.filtration")],
  [t("work.spec.lighting"), t("work.project1.spec.lighting")],
  [t("work.spec.substrate"), t("work.project1.spec.substrate")],
  [t("work.spec.co2"), t("work.project1.spec.co2")],
  [t("work.spec.fish"), t("work.project1.spec.fish")],
  [t("work.spec.otherInhabitants"), t("work.project1.spec.otherInhabitants")],
  [t("work.spec.plants"), t("work.project1.spec.plants")],
];

const project2Specs = [
  [t("work.spec.started"), t("work.project2.spec.started")],
  [t("work.spec.dimensions"), t("work.project2.spec.dimensions")],
  [t("work.spec.volume"), t("work.project2.spec.volume")],
  [t("work.spec.filtration"), t("work.project2.spec.filtration")],
  [t("work.spec.substrate"), t("work.project2.spec.substrate")],
  [t("work.spec.lighting"), t("work.project2.spec.lighting")],
  [t("work.spec.co2"), t("work.project2.spec.co2")],
  [t("work.spec.fish"), t("work.project2.spec.fish")],
  [t("work.spec.otherInhabitants"), t("work.project2.spec.otherInhabitants")],
  [t("work.spec.plants"), t("work.project2.spec.plants")],
];

const project3Specs = [
  [t("work.spec.started"), t("work.project3.spec.started")],
  [t("work.spec.dimensions"), t("work.project3.spec.dimensions")],
  [t("work.spec.volume"), t("work.project3.spec.volume")],
  [t("work.spec.filtration"), t("work.project3.spec.filtration")],
  [t("work.spec.lighting"), t("work.project3.spec.lighting")],
  [t("work.spec.substrate"), t("work.project3.spec.substrate")],
  [t("work.spec.co2"), t("work.project3.spec.co2")],
  [t("work.spec.fish"), t("work.project3.spec.fish")],
  [t("work.spec.otherInhabitants"), t("work.project3.spec.otherInhabitants")],
  [t("work.spec.plants"), t("work.project3.spec.plants")],
];
---

<Layout title={t("work.meta.title")} description={t("work.meta.description")}>
  <Header />

  <main>
    <!-- =====================================================
         INTRO
         ===================================================== -->

    <section class="page-intro work-page-intro">
      <p class="eyebrow">{t("work.hero.eyebrow")}</p>
      <h1 set:html={t("work.hero.title")} />
      <p class="page-intro-text">{t("work.hero.text")}</p>
    </section>

    <!-- =====================================================
         FALLEN FOREST
         ===================================================== -->

    <article class="case-study">
      {work.project1.hero && (
        <div class="case-study-hero case-study-hero-contain">
          <Image
            src={work.project1.hero.image}
            alt={altFor("project1", work.project1.hero.fileName, t("work.project1.image.alt"))}
            format="webp"
            widths={heroWidths}
            sizes={heroSizes}
            {...heroLoading("project1")}
          />
        </div>
      )}

      <div class="case-study-header">
        <div>
          <p class="eyebrow">{t("work.project1.eyebrow")}</p>
          <h2 set:html={t("work.project1.title")} />
        </div>

        <p class="case-study-intro">{t("work.project1.intro")}</p>
      </div>

      <div class="case-study-body">
        <div class="case-study-story">
          <p>{t("work.project1.story.p1")}</p>
          <p>{t("work.project1.story.p2")}</p>
          <p>{t("work.project1.story.p3")}</p>
          <p>{t("work.project1.story.p4")}</p>
          <p>{t("work.project1.story.p5")}</p>
        </div>

        <aside class="ecosystem-details">
          <p class="eyebrow">{t("work.project1.ecosystemEyebrow")}</p>

          <div class="ecosystem-principle">
            <p>{t("work.project1.principle.p1")}</p>
            <p>{t("work.project1.principle.p2")}</p>
            <p>{t("work.project1.principle.p3")}</p>
          </div>

          <div class="details-grid">
            {project1Specs.map(([label, value]) => (
              <div>
                <span>{label}</span>
                <strong>{value}</strong>
              </div>
            ))}
          </div>
        </aside>
      </div>

      {work.project1.gallery.length > 0 && (
        <div class="case-study-gallery">
          {work.project1.gallery.map((photo, index) => (
            <Image
              src={photo.image}
              alt={altFor("project1", photo.fileName, t("work.project1.gallery.alt"))}
              format="webp"
              {...galleryProps(index)}
            />
          ))}
        </div>
      )}
    </article>

    <!-- =====================================================
         ORINOCO / LITTORAL
         ===================================================== -->

    <article class="case-study">
      {work.project2.hero && (
        <div class="case-study-hero">
          <Image
            src={work.project2.hero.image}
            alt={altFor("project2", work.project2.hero.fileName, t("work.project2.image.alt"))}
            format="webp"
            widths={heroWidths}
            sizes={heroSizes}
            {...heroLoading("project2")}
          />
        </div>
      )}

      <div class="case-study-header">
        <div>
          <p class="eyebrow">{t("work.project2.eyebrow")}</p>
          <h2 set:html={t("work.project2.title")} />
        </div>

        <p class="case-study-intro">{t("work.project2.intro")}</p>
      </div>

      <div class="case-study-body">
        <div class="case-study-story">
          <p>{t("work.project2.story.p1")}</p>
          <p set:html={t("work.project2.story.p2")} />
          <p set:html={t("work.project2.story.p3")} />
          <p>{t("work.project2.story.p4")}</p>
        </div>

        <aside class="ecosystem-details">
          <p class="eyebrow">{t("work.project2.ecosystemEyebrow")}</p>

          <div class="details-grid">
            {project2Specs.map(([label, value]) => (
              <div>
                <span>{label}</span>
                <strong>{value}</strong>
              </div>
            ))}
          </div>
        </aside>
      </div>

      {work.project2.gallery.length > 0 && (
        <div class="case-study-gallery">
          {work.project2.gallery.map((photo, index) => (
            <Image
              src={photo.image}
              alt={altFor("project2", photo.fileName, t("work.project2.gallery.alt"))}
              format="webp"
              {...galleryProps(index)}
            />
          ))}
        </div>
      )}
    </article>

    <!-- =====================================================
         BORNEO UNDERSTORY
         ===================================================== -->

    <article class="case-study">
      {work.project3.hero && (
        <div class="case-study-hero">
          <Image
            src={work.project3.hero.image}
            alt={altFor("project3", work.project3.hero.fileName, t("work.project3.image.alt"))}
            format="webp"
            widths={heroWidths}
            sizes={heroSizes}
            {...heroLoading("project3")}
          />
        </div>
      )}

      <div class="case-study-header">
        <div>
          <p class="eyebrow">{t("work.project3.eyebrow")}</p>
          <h2 set:html={t("work.project3.title")} />
        </div>

        <p class="case-study-intro">{t("work.project3.intro")}</p>
      </div>

      <div class="case-study-body">
        <div class="case-study-story">
          <p>{t("work.project3.story.p1")}</p>
          <p>{t("work.project3.story.p2")}</p>
          <p>{t("work.project3.story.p3")}</p>
          <p>{t("work.project3.story.p4")}</p>
        </div>

        <aside class="ecosystem-details">
          <p class="eyebrow">{t("work.project3.ecosystemEyebrow")}</p>

          <div class="details-grid">
            {project3Specs.map(([label, value]) => (
              <div>
                <span>{label}</span>
                <strong>{value}</strong>
              </div>
            ))}
          </div>
        </aside>
      </div>

      {work.project3.gallery.length > 0 && (
        <div class="case-study-gallery">
          {work.project3.gallery.map((photo, index) => (
            <Image
              src={photo.image}
              alt={altFor("project3", photo.fileName, t("work.project3.gallery.alt"))}
              format="webp"
              {...galleryProps(index)}
            />
          ))}
        </div>
      )}
    </article>

    <!-- =====================================================
         CLOSING
         ===================================================== -->

    <section class="work-closing">
      <p class="eyebrow">{t("work.closing.eyebrow")}</p>
      <h2 set:html={t("work.closing.title")} />
      <p>{t("work.closing.text")}</p>

      <a href={getRelativeLocaleUrl(lang, "/contact")} class="button dark-button">
        {t("work.closing.button")}
      </a>
    </section>
  </main>

  <Footer />
</Layout>
