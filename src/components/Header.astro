---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLangFromUrl, getPathWithoutLocale, useTranslations } from "../i18n/utils";

interface Props {
  variant?: "page" | "site";
}

const { variant = "page" } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const path = getPathWithoutLocale(Astro.url);
---

<header class={variant === "site" ? "site-header" : "page-header"}>
  {/* Runs before the header is drawn, so the phone menu never flashes open.
      Without JavaScript this class is missing and the links show as always. */}
  <script is:inline>document.documentElement.classList.add("has-js");</script>

  <nav class="nav">
    <a href={getRelativeLocaleUrl(lang, "/")} class="logo">Microcosmos Atelier</a>

    <button
      type="button"
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="site-navigation"
    >
      {t("nav.menu")}
    </button>

    <div class="navigation" id="site-navigation">
      <a href={getRelativeLocaleUrl(lang, "/our-work")}>{t("nav.ourWork")}</a>
      <a href={getRelativeLocaleUrl(lang, "/about")}>{t("nav.about")}</a>
      <a href={getRelativeLocaleUrl(lang, "/contact")}>{t("nav.contact")}</a>
      <a href={getRelativeLocaleUrl(lang, "/journal")}>{t("nav.journal")}</a>

      <div class="language-switcher">
        <a href={getRelativeLocaleUrl("nl", path)} class={lang === "nl" ? "active" : ""}>NL</a>
        <span>·</span>
        <a href={getRelativeLocaleUrl("en", path)} class={lang === "en" ? "active" : ""}>EN</a>
      </div>
    </div>
  </nav>
</header>

<script>
  // Menu button at ≤ 800px (SPEC.md §3.8, a disclosure, not a modal).
  const header = document.querySelector<HTMLElement>(".site-header, .page-header");
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const panel = document.getElementById("site-navigation");

  if (toggle && panel) {
    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      panel.classList.toggle("is-open", open);
    };

    toggle.addEventListener("click", () => setOpen(!isOpen()));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });

    // A tap outside the panel or a chosen link closes it. `pointerdown`, not
    // `click`: iOS Safari doesn't send clicks on plain text or images up to
    // `document`, so a tap outside would otherwise be missed.
    document.addEventListener("pointerdown", (event) => {
      const target = event.target as Node;
      if (isOpen() && !panel.contains(target) && !toggle.contains(target)) setOpen(false);
    });
    panel.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) setOpen(false);
    });

    // Growing past 800px never leaves the desktop header in a mobile state.
    window.matchMedia("(max-width: 800px)").addEventListener("change", (event) => {
      if (!event.matches) setOpen(false);
    });
  }

  // Header that hides on scroll down and returns on scroll up (SPEC.md §3.8).
  if (header) {
    const hero = document.querySelector<HTMLElement>(".hero");
    const THRESHOLD = 6; // px of scrolling before the header reacts, against flicker
    let lastY = window.scrollY;
    let ticking = false;

    // Only keyboard focus keeps the header in view (a mouse click or tap
    // also focuses a link or button, but shouldn't pin the header). Older
    // Safari (before 15.4) doesn't know :focus-visible, so fall back to :focus.
    const focusSelector = CSS.supports("selector(:focus-visible)") ? ":focus-visible" : ":focus";
    const keepVisible = () =>
      header.querySelector(focusSelector) !== null ||
      toggle?.getAttribute("aria-expanded") === "true";

    const update = () => {
      ticking = false;
      // Clamp against iOS rubber-banding past the top or bottom, which would
      // otherwise read as scrolling up and bring the header back.
      const maxY = document.documentElement.scrollHeight - window.innerHeight;
      const y = Math.min(Math.max(window.scrollY, 0), Math.max(maxY, 0));
      const height = header.offsetHeight;

      // Solid once the header no longer sits over a photo: on the home page
      // when the hero has scrolled out from under it, elsewhere past its height.
      const solid = hero ? hero.getBoundingClientRect().bottom <= height : y > height;
      header.classList.toggle("is-solid", solid);

      if (y <= height) {
        header.classList.remove("is-hidden");
        lastY = y;
        return;
      }
      if (Math.abs(y - lastY) < THRESHOLD) return;
      header.classList.toggle("is-hidden", y > lastY && !keepVisible());
      lastY = y;
    };

    const schedule = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener("scroll", schedule, { passive: true });
    // Rotating or resizing changes the hero's position: recheck the colour.
    window.addEventListener("resize", schedule);
    // A restored scroll position or a jump to a #section isn't a scroll by
    // the visitor: start counting from there instead of hiding right away.
    const resetFromHere = () => {
      lastY = window.scrollY;
      update();
    };
    window.addEventListener("load", resetFromHere);
    window.addEventListener("pageshow", resetFromHere);
    header.addEventListener("focusin", () => header.classList.remove("is-hidden"));
    update();
  }
</script>
